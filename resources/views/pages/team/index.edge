@let(isDatastar = request.header('datastar-request'))

@if(!isDatastar)
  @layout.app({ title })
    @slot('meta')
      <meta name="description" content="{{ metaDescription }}" />
    @endslot
    
    @slot('main')
      @include('pages/team/_content')
    @endslot
  @end
@else
  @include('pages/team/_content')
@end
